{
  "modName": "Overture",
  "displayName": "Overture",
  "minMcmVersion": 1,
  "pluginRequirements": [
    "Overture.esp"
  ],
  "pages": [
    {
      "pageDisplayName": "Overture",
      "content": [
        {
          "type": "text",
          "text": "Walk up to someone and try. How it went is told by Rapport's Narrator (its \"addon moments\" switch). Changes apply from the next reply; the lover bond, from the next conversation that ends."
        },
        {
          "type": "section",
          "text": "Starting"
        },
        {
          "type": "button",
          "text": "Start now",
          "help": "Overture waits until you leave Vault 111. If an alternate start mod means it never started, press this: Overture, Rapport and the mods built on it start now, in this save. Needs Rapport 0.2.2.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:Core",
            "function": "StartNow",
            "params": []
          }
        },
        {
          "type": "section",
          "text": "Overture"
        },
        {
          "type": "switcher",
          "text": "Approaches",
          "help": "Talking to someone opens the approach, once a game day. Off: everyone has only their own dialogue.",
          "valueOptions": {
            "sourceType": "GlobalValue",
            "sourceForm": "Overture.esp|842"
          }
        },
        {
          "type": "switcher",
          "id": "bScenes:Switches",
          "text": "A yes starts a scene",
          "help": "When someone says yes, Rapport starts the scene. Off: they say yes and nothing more happens.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "switcher",
          "id": "bIvyFade:Ivy",
          "text": "Ivy: her fade becomes a scene",
          "help": "When Ivy's own Favor: Sex scene fades to black, Rapport plays the scene, then hers carries on. Needs 'A yes starts a scene'.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "section",
          "text": "What words are worth"
        },
        {
          "type": "slider",
          "id": "fLandFirst:Words",
          "text": "The first thing that lands",
          "help": "How much the bond grows when the first approach lands (a share of the distance left, as every source moves it).",
          "valueOptions": {
            "min": 0.0,
            "max": 0.3,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fLandSecond:Words",
          "text": "The second thing that lands",
          "help": "The same, for the second exchange.",
          "valueOptions": {
            "min": 0.0,
            "max": 0.3,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fOffend:Words",
          "text": "Blunt at the wrong person",
          "help": "What crude words cost with someone who did not want them.",
          "valueOptions": {
            "min": -0.3,
            "max": 0.0,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fRecoil:Words",
          "text": "Crude in public",
          "help": "What an intimate line costs in front of people, with someone who would not have liked it anyway.",
          "valueOptions": {
            "min": -0.3,
            "max": 0.0,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fNotYet:Words",
          "text": "Asked too soon",
          "help": "A proposition answered \"not yet\" still means something.",
          "valueOptions": {
            "min": 0.0,
            "max": 0.2,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fRefuse:Words",
          "text": "Asked the wrong way",
          "help": "A proposition refused.",
          "valueOptions": {
            "min": -0.3,
            "max": 0.0,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "section",
          "text": "How close before a yes"
        },
        {
          "type": "slider",
          "id": "fBarMercantile:Bars",
          "text": "Mercantile",
          "help": "The bond a mercantile person needs before they say yes.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fBarRomantic:Bars",
          "text": "Romantic",
          "help": "The same for a romantic, who also wants the right moment.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fBarVulgar:Bars",
          "text": "Vulgar",
          "help": "The fast lane.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fBarReticent:Bars",
          "text": "Reticent",
          "help": "They take days to open up.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fLoverBond:Bars",
          "text": "Lovers from a bond of",
          "help": "At this bond, conversations open at the proposition - from the next one after a conversation ends there. With a scene together as well, you are a couple to everyone else too.",
          "valueOptions": {
            "min": 0.3,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "section",
          "text": "Spoken for"
        },
        {
          "type": "slider",
          "id": "fFaithRefuses:SpokenFor",
          "text": "Faithful enough to always refuse",
          "help": "Someone married or courting refuses outright at this faithfulness or above.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fFaithWeight:SpokenFor",
          "text": "How much being spoken for raises the bar",
          "help": "Below that, the bar rises by this much of their faithfulness.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "section",
          "text": "Jealousy"
        },
        {
          "type": "slider",
          "id": "fJealousySting:Jealousy",
          "text": "When it hurts",
          "help": "What a romantic or reticent lover's bond loses on hearing you have been with someone else.",
          "valueOptions": {
            "min": -0.3,
            "max": 0.0,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fJealousyThrill:Jealousy",
          "text": "When it thrills",
          "help": "What a vulgar lover's bond gains on hearing it. The mercantile shrug.",
          "valueOptions": {
            "min": 0.0,
            "max": 0.2,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "section",
          "text": "Companions"
        },
        {
          "type": "slider",
          "id": "fDesireMercantile:Companions",
          "text": "Wanting before a yes: mercantile",
          "help": "How much a mercantile companion has to want it before they say yes (0 to 1). It builds with every day on the road together, and a scene together sates it.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fDesireRomantic:Companions",
          "text": "Wanting before a yes: romantic",
          "help": "The same, for a romantic companion.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fDesireVulgar:Companions",
          "text": "Wanting before a yes: vulgar",
          "help": "The same, for a vulgar companion.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fDesireReticent:Companions",
          "text": "Wanting before a yes: reticent",
          "help": "The same, for a reticent companion.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fRomancedEase:Companions",
          "text": "Romanced: the bar is lower by",
          "help": "A companion you have romanced, by their own romance, needs this much less.",
          "valueOptions": {
            "min": 0.0,
            "max": 0.5,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fAffinityGate:Companions",
          "text": "No romance of their own: affinity needed",
          "help": "Companions the game gives no romance (X6-88, Deacon, Gage, Old Longfellow) need their own affinity this high first: 1 is their top level, 0.75 the one below it.",
          "valueOptions": {
            "min": 0.25,
            "max": 1.0,
            "step": 0.25,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fDesirePerDay:Companions",
          "text": "Wanting grows per day together",
          "help": "How much a game day travelling together builds wanting.",
          "valueOptions": {
            "min": 0.0,
            "max": 0.5,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fTogetherPerDay:Companions",
          "text": "A day together adds to the bond",
          "help": "A share of the distance left, as every source moves Rapport's bond.",
          "valueOptions": {
            "min": 0.0,
            "max": 0.1,
            "step": 0.005,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fThresholdUp:Companions",
          "text": "Their affinity reaches a new level",
          "help": "What each level of their own affinity adds to the bond, the first time they reach it (Friend, Admiration, Confidant, Infatuation).",
          "valueOptions": {
            "min": 0.0,
            "max": 0.3,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fThresholdDown:Companions",
          "text": "Their affinity falls to Disdain or Hatred",
          "help": "What each of those takes away, once per fall.",
          "valueOptions": {
            "min": -0.3,
            "max": 0.0,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fMomentCooldown:Companions",
          "text": "Days between moments",
          "help": "After a moment is used or passes unused, how many game days before a companion who still wants you asks again.",
          "valueOptions": {
            "min": 0.5,
            "max": 7.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Debug",
      "content": [
        {
          "type": "text",
          "text": "Overture's entry points on demand, for testing. Face the NPC you mean, then click - or bind a key below. FORCED skips the checks; REAL goes through the same door as play and says on the HUD what refused."
        },
        {
          "type": "section",
          "text": "Approach"
        },
        {
          "type": "button",
          "text": "Approach the one I face - FORCED",
          "help": "Overture's approach scene on the NPC you are facing, eligible or not (what F4MCP's \"approach <npc>\" does).",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Overture:DebugTriggers",
            "function": "ApproachForced",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "Approach the one I face - REAL",
          "help": "You talk to them, and the game picks the greeting exactly as in play: the approach only when every condition holds. From this page it opens once the menu is closed.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Overture:DebugTriggers",
            "function": "ApproachReal",
            "params": []
          }
        },
        {
          "type": "section",
          "text": "A yes"
        },
        {
          "type": "button",
          "text": "Straight to a yes - FORCED",
          "help": "A yes from the NPC you are facing without asking: the same markers, Narrator line and scene request a real yes gets - the scene even with \"A yes starts a scene\" off.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Overture:DebugTriggers",
            "function": "YesForced",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "Straight to a yes - REAL",
          "help": "The stage-3 verdict decides (bond, room, setting, Rapport free); the HUD says why when it is not a yes. A yes asks for its scene only with \"A yes starts a scene\" on.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Overture:DebugTriggers",
            "function": "YesReal",
            "params": []
          }
        },
        {
          "type": "section",
          "text": "Hotkeys"
        },
        {
          "id": "OvertureApproachForced",
          "text": "Approach - forced",
          "type": "hotkey",
          "help": "Overture's approach scene on the NPC you are facing, eligible or not (what F4MCP's \"approach <npc>\" does)."
        },
        {
          "id": "OvertureApproachReal",
          "text": "Approach - real",
          "type": "hotkey",
          "help": "You talk to them, and the game picks the greeting exactly as in play: the approach only when every condition holds. From this page it opens once the menu is closed."
        },
        {
          "id": "OvertureYesForced",
          "text": "Yes - forced",
          "type": "hotkey",
          "help": "A yes from the NPC you are facing without asking: the same markers, Narrator line and scene request a real yes gets - the scene even with \"A yes starts a scene\" off."
        },
        {
          "id": "OvertureYesReal",
          "text": "Yes - real",
          "type": "hotkey",
          "help": "The stage-3 verdict decides (bond, room, setting, Rapport free); the HUD says why when it is not a yes. A yes asks for its scene only with \"A yes starts a scene\" on."
        }
      ]
    }
  ]
}
